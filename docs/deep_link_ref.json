{
  "_comment": "Deep Link Short Name Reference",
  "_format": "https://t.me/bot?start=STEP1--STEP2--STEP3",
  "_separator": "-- (double dash) between steps, = between key and value",
  "_example_1": "o=cal                  => open=calendar",
  "_example_2": "p=2                    => page=2 (main menu page 2)",
  "_example_3": "o=hp--p=2--o=co        => open=help page=2 open=commands_overview",
  "_example_4": "o=sm--mt=sph           => open=schedule_message media_type=single_photo",
  "_example_5": "o=sch--c=cnt--c=ods    => open=schedule click=continue click=open_date_setter",

  "actions": {
    "open": "o",
    "page": "p",
    "click": "c",
    "message": "m"
  },

